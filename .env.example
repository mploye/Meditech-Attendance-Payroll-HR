# Copy to .env and fill every value. NEVER commit real secrets.

# --- Public endpoints (same origin for both UI and API) ---
# Must point at an A/AAAA record that resolves to this server's public IP.
DOMAIN=hrms.example.com
PUBLIC_URL=https://hrms.example.com

# --- Postgres ---
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hrms

# --- Backend auth / security ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEVICE_CONNECTOR_API_KEY=CHANGE_ME_CONNECTOR_KEY

# --- App ---
APP_ENV=production
DEBUG=false

# --- eSSL integration (keep mock until real portal creds are configured) ---
ESSL_MOCK_MODE=true
ESSL_BASE_URL=https://localhost/portal/api/essl/etimetracklite
ESSL_USERNAME=
ESSL_PASSWORD=
ESSL_API_KEY=
ESSL_COMPANY_SHORT_NAME=
ESSL_TIMEOUT_SECONDS=30
ESSL_SYNC_INTERVAL_SECONDS=300