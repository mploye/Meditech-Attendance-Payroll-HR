# Caddy reverse proxy — auto-HTTPS via Let's Encrypt (requires A record + ports 80/443 open).
{$DOMAIN} {
    @api path /api/* /static/*
    handle @api {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
    encode gzip zstd
    header {
        -Server
        X-Content-Type-Options nosniff
    }
    log {
        output stdout
        format console
    }
}