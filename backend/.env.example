# App
APP_ENV=development
DEBUG=true

# Database (Supabase Postgres for production, SQLite for local dev)
DATABASE_URL=sqlite:///./hrms.db

# Auth
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# eSSL / eTimeTrackLite
ESSL_MOCK_MODE=true
ESSL_BASE_URL=https://localhost/portal/api/essl/etimetracklite
ESSL_USERNAME=
ESSL_PASSWORD=
ESSL_API_KEY=
ESSL_COMPANY_SHORT_NAME=
ESSL_TIMEOUT_SECONDS=30
ESSL_SYNC_INTERVAL_SECONDS=300

# Connector
DEVICE_CONNECTOR_API_KEY=change-me-connector-key

# Line below is for local dev only, never commit real secrets
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=